{
  "name": "@openfort/ethereum-light-client",
  "version": "0.1.0",
  "description": "TypeScript implementation of Ethereum light client using Lodestar",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "nodemon --exec tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "ts-mocha test/**/*.test.ts",
    "test:watch": "ts-mocha --watch test/**/*.test.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "example:sync": "tsx examples/basic-sync.ts",
    "example:balance": "tsx examples/get-balance.ts",
    "example:verify": "tsx examples/verify-transaction.ts",
    "clean": "rimraf dist node_modules",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ethereum",
    "light-client",
    "blockchain",
    "consensus",
    "sync-committee",
    "beacon-chain"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@chainsafe/bls": "^7.1.3",
    "@lodestar/api": "^1.22.0",
    "@lodestar/light-client": "^1.22.0",
    "@lodestar/params": "^1.22.0",
    "@lodestar/types": "^1.22.0",
    "@noble/hashes": "^1.5.0",
    "axios": "^1.7.0",
    "dotenv": "^17.0.0",
    "ethereum-cryptography": "^2.2.1",
    "ethers": "^6.13.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@chainsafe/as-sha256": "^0.4.1",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "chai": "^4.5.0",
    "eslint": "^8.57.0",
    "mocha": "^10.7.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
