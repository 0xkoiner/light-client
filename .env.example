# Network (sepolia, mainnet, holesky)
NETWORK=sepolia

# Beacon Node (Consensus Layer) - Required for light client
BEACON_NODE_URL=https://lodestar-sepolia.chainsafe.io

# Execution RPC (Execution Layer) - For state proofs
# Option 1: Public endpoint (free, no signup)
EXECUTION_RPC_URL=https://rpc.sepolia.org

# Option 2: Alchemy (better rate limits, free account)
# EXECUTION_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Option 3: Infura (free account)
# EXECUTION_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Trusted Checkpoint Root (optional, fetched automatically if not provided)
# CHECKPOINT_ROOT=

# Debug logging (optional)
DEBUG=false
