# Network Configuration
NETWORK=sepolia

# Beacon Node URL (for consensus layer)
BEACON_NODE_URL=https://lodestar-sepolia.chainsafe.io

# Execution RPC URL (for balance queries, state access, etc.)
# Get your API key from https://www.alchemy.com/ or https://infura.io/
EXECUTION_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# Trusted Checkpoint Root (optional, can be fetched from checkpoint sync service)
CHECKPOINT_ROOT=

# Checkpoint Sync URL
CHECKPOINT_SYNC_URL=https://checkpoint-sync.sepolia.ethpandaops.io
